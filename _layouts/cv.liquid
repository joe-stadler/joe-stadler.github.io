---
layout: default
---
<style>
  /* Local fix: wider date column so "2025 - PRESENT" and long locations do not overlap the entry title */
  .cv .row > .date-column { flex: 0 0 22%; max-width: 22%; }
  .cv .row > .date-column + div { flex: 0 0 78%; max-width: 78%; }
  .cv .date-column .badge { white-space: nowrap; min-width: 0 !important; font-size: 0.7rem; }
  .cv .date-column p.location { white-space: normal; }
  @media (max-width: 575.98px) {
    .cv .row > .date-column { flex: 0 0 100%; max-width: 100%; text-align: left !important; }
    .cv .row > .date-column + div { flex: 0 0 100%; max-width: 100%; }
  }
</style>
{% assign cv_feature_enabled = site.al_folio.features.cv.enabled | default: true %}

{% if site.plugins contains 'al_folio_cv' and cv_feature_enabled %}
  {% al_folio_cv_render %}
{% else %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">CV rendering is unavailable.</p>
    </header>
    <article>
      <p>Enable the <code>al_folio_cv</code> plugin and set <code>al_folio.features.cv.enabled: true</code> to render this page.</p>
    </article>
  </div>
{% endif %}
